# Copy to .env and fill in — docker-compose.yml reads this file automatically.

# Required: at least one LLM provider key, or every specialist/conversation
# call fails at the router (llm/router.py raises rather than silently no-op).
ANTHROPIC_API_KEY=

# Optional: live flight search. Without it, providers/registry.py's
# AviationStackFlightProvider falls back to seeded mock data.
AVIATIONSTACK_API_KEY=

# MCP server (mcp_server/server.py) reachable by the api service and every
# worker-* container — see docker-compose.yml's mcp-server service. Only
# needed outside docker-compose (e.g. running smi-conversation-worker or
# smi-agent-worker directly against a locally-started smi-mcp-server).
SMI_MCP_SERVER_URL=http://localhost:9200/mcp
